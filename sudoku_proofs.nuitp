set module SUDOKU .
genset GEN-BOOL for Bool is True ;; False .
genset GEN-NAT for Nat is 0 ;; s 0 ;; s N:NzNat .
genset GEN-NZNAT for NzNat is s 0 ;; s N:NzNat .
genset GEN-LIST for List is nilList ;; N:Nat ;; N:Nat R:NeList .
genset GEN-NELIST for NeList is N:Nat ;; N:Nat R:NeList .
genset GEN-MAT for NatMatrix is emptyMatrix ;; R:NeList ; M:NeNatMatrix .
genset GEN-NEMAT for NeNatMatrix is R:NeList ;; R:NeList ; M:NeNatMatrix .
genset GEN-MSET for NatMSet is nilMSet ;; N:Nat ;; N:Nat : S:NeNatMSet .
genset GEN-NEMSET for NeNatMSet is N:Nat ;; N:Nat : S:NeNatMSet .
genset GEN-NEMAT2 for NeNatMatrix is R:NeList ;; R1:NeList ; R2:NeList ;; R1:NeList ; M:NeNatMatrix ; R2:NeList .
genset GEN-NELIST2 for NeList is R:Nat ;; R1:Nat R2:Nat ;; R1:Nat M:NeList R2:Nat .

strat GND is try-gnd ; try-eps ; try-cs ; try-icc .
strat GSI is try-gsi ; try-cs ; try-cvul ; try-cs ; try-icc ; try-cs .

