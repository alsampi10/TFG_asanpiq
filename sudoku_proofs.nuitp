apply cut* to 0.3.1.2 with takeCorners($1:NeNatMatrix, $2:NzNat) : takeOverlap($1:NeNatMatrix, $2:NzNat) = takeRing($1:NeNatMatrix, $2:NzNat) : takeOverlap($1:NeNatMatrix, $2:NzNat) .
